{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-coding-maestro/schemas/capabilities.v1.schema.json",
  "title": "Vibe Coding Maestro capability ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "ownerPath",
          "contractId",
          "depths",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "status": {
            "enum": [
              "keep",
              "adapt",
              "reject"
            ]
          },
          "ownerPath": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^protocols/.+\\.md$"
          },
          "contractId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^VCM-[A-Z0-9-]+$"
          },
          "depths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "light",
                "standard",
                "advanced"
              ]
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "reject"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "ownerPath": {
                  "type": "null"
                },
                "contractId": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "keep",
                    "adapt"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "ownerPath": {
                  "type": "string",
                  "pattern": "^protocols/.+\\.md$"
                },
                "contractId": {
                  "type": "string",
                  "pattern": "^VCM-[A-Z0-9-]+$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
