{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-coding-maestro/schemas/manifest.schema.json",
  "title": "Манифест проекта Vibe Coding Maestro",
  "description": "Служебный файл .maestro/manifest.json: что инструмент создал и кому принадлежит каждый файл.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "project", "managed"],
  "properties": {
    "schemaVersion": {
      "description": "Версия формата манифеста. Растёт при несовместимых изменениях.",
      "type": "integer",
      "minimum": 1
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "createdBy"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "createdBy": { "type": "string", "minLength": 1 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "startingPoint", "createdAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "startingPoint": {
          "description": "Исходное состояние идеи на момент создания проекта.",
          "type": "string",
          "enum": ["idea", "materials", "spec", "code"]
        },
        "createdAt": {
          "description": "Момент создания проекта в ISO 8601 (UTC).",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "managed": {
      "description": "Файлы, о которых знает инструмент, с указанием вида владения.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind"],
        "properties": {
          "path": {
            "description": "Относительный POSIX-путь от корня проекта.",
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "description": "managed — файл инструмента; merged — файл пользователя с дописанными строками; generated — служебный файл.",
            "type": "string",
            "enum": ["managed", "merged", "generated"]
          }
        }
      }
    }
  }
}
