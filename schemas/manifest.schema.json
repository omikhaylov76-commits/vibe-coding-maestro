{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-coding-maestro/schemas/manifest.schema.json",
  "title": "Манифест проекта Vibe Coding Maestro v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "project", "managed", "inventory"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "createdBy"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "createdBy": { "type": "string", "minLength": 1 }
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "startingPoint", "createdAt", "depth"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
        "name": { "type": "string", "minLength": 1 },
        "startingPoint": { "type": "string", "enum": ["idea", "materials", "spec", "code"] },
        "createdAt": { "type": "string", "minLength": 1 },
        "depth": { "type": "string", "enum": ["light", "standard", "advanced"] }
      }
    },
    "managed": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "kind"],
        "properties": {
          "path": { "$ref": "#/definitions/safePath" },
          "kind": { "type": "string", "enum": ["managed", "merged", "generated"] }
        }
      }
    },
    "inventory": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "ownership"],
        "properties": {
          "path": { "$ref": "#/definitions/safePath" },
          "ownership": { "type": "string", "enum": ["managed", "generated", "project-owned", "immutable"] }
        }
      }
    }
  },
  "definitions": {
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!\\.git(?:/|$))(?!.*\\\\)(?!.*//)(?!\\./)(?!.*(?:^|/)\\.(?:/|$)).+$"
    }
  }
}
